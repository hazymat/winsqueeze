<Window x:Class="WinSqueeze.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="WinSqueeze" Icon="Assets/WinSqueeze.ico" Width="1200" Height="780" MinWidth="300" MinHeight="150" Background="#101114">
  <Window.TaskbarItemInfo>
    <TaskbarItemInfo>
      <TaskbarItemInfo.ThumbButtonInfos>
        <ThumbButtonInfo x:Name="previousThumb" Description="Previous" Click="OnPreviousThumb">
          <ThumbButtonInfo.ImageSource><DrawingImage><DrawingImage.Drawing><GeometryDrawing Brush="White" Geometry="M2,2 L4,2 L4,14 L2,14 Z M14,2 L14,14 L5,8 Z" /></DrawingImage.Drawing></DrawingImage></ThumbButtonInfo.ImageSource>
        </ThumbButtonInfo>
        <ThumbButtonInfo x:Name="playPauseThumb" Description="Play/Pause" Click="OnPlayPauseThumb">
          <ThumbButtonInfo.ImageSource><DrawingImage><DrawingImage.Drawing><GeometryDrawing Brush="White" Geometry="M1,2 L8,8 L1,14 Z M10,2 L12,2 L12,14 L10,14 Z M13.5,2 L15.5,2 L15.5,14 L13.5,14 Z" /></DrawingImage.Drawing></DrawingImage></ThumbButtonInfo.ImageSource>
        </ThumbButtonInfo>
        <ThumbButtonInfo x:Name="nextThumb" Description="Next" Click="OnNextThumb">
          <ThumbButtonInfo.ImageSource><DrawingImage><DrawingImage.Drawing><GeometryDrawing Brush="White" Geometry="M12,2 L14,2 L14,14 L12,14 Z M2,2 L2,14 L11,8 Z" /></DrawingImage.Drawing></DrawingImage></ThumbButtonInfo.ImageSource>
        </ThumbButtonInfo>
      </TaskbarItemInfo.ThumbButtonInfos>
    </TaskbarItemInfo>
  </Window.TaskbarItemInfo>
  <wv2:WebView2 x:Name="webView" />
</Window>
