<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WinSqueeze</RootNamespace>
    <AssemblyName>WinSqueeze</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <Version>0.1.0</Version>
    <StartupObject>WinSqueeze.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="Velopack" Version="0.0.1298" />
  </ItemGroup>
  <ItemGroup>
    <!-- Custom Main so Velopack can handle install/update hooks before WPF starts -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>
  <ItemGroup>
    <!-- WinForms is only used for the tray icon; keep its names out of the WPF namespace -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <!-- Pinned Squeezelite and its licence, copied next to the exe -->
    <None Include="..\vendor\squeezelite\squeezelite-ffmpeg-x64.exe;..\vendor\squeezelite\LICENSE;..\vendor\squeezelite\SOURCE.md" Link="squeezelite\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- Built web UI (npm run build in /ui) -->
    <None Include="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
