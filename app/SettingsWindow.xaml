<Window x:Class="WinSqueeze.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinSqueeze Settings" Icon="Assets/WinSqueeze.ico" Width="760" Height="560" MinWidth="620" MinHeight="460" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style TargetType="TextBlock" x:Key="Label"><Setter Property="Margin" Value="0,10,0,3" /></Style>
    <Style TargetType="TextBlock" x:Key="Quiet"><Setter Property="Foreground" Value="#666" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Margin" Value="0,4,0,0" /></Style>
    <Style TargetType="Button"><Setter Property="Padding" Value="12,4" /><Setter Property="Margin" Value="0,0,8,0" /></Style>
    <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,8,0,0" /></Style>
  </Window.Resources>
  <TabControl x:Name="settingsTabs" Margin="8">
    <TabItem Header="General" x:Name="generalTab">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="16">
        <CheckBox x:Name="startWithWindowsBox" Content="Start with Windows" />
        <CheckBox x:Name="startMinimisedBox" Content="Start minimised to tray" />
        <CheckBox x:Name="closeHidesBox" Content="Close (X) hides to tray and keeps playing (otherwise it quits)" />
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0"><CheckBox x:Name="showHintsBox" Content="Show hints around the app" VerticalAlignment="Center" /><Button x:Name="resetHintsButton" Content="Show all hints again" Margin="12,0,0,0" Padding="10,2" /></StackPanel>
        <TextBlock Style="{StaticResource Label}" Text="When another Squeezelite is running at launch" Margin="0,16,0,3" />
        <ComboBox x:Name="otherSqueezeliteCombo" Width="320" HorizontalAlignment="Left">
          <ComboBoxItem Content="Ask me" Tag="Ask" />
          <ComboBoxItem Content="Always stop it" Tag="Stop" />
          <ComboBoxItem Content="Leave it running" Tag="Leave" />
        </ComboBox>
        <TextBlock Text="Settings file" FontWeight="SemiBold" Margin="0,20,0,4" />
        <StackPanel Orientation="Horizontal">
          <Button x:Name="exportSettingsButton" Content="Export settings…" />
          <Button x:Name="importSettingsButton" Content="Import settings…" />
        </StackPanel>
        <TextBlock x:Name="settingsFileText" Style="{StaticResource Quiet}" Text="Exports everything except passwords, as a JSON file you can keep or copy to another PC." />
      </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="Servers" x:Name="serversTab">
      <Grid Margin="16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <DockPanel Grid.Column="0" Margin="0,0,16,0">
          <TextBlock DockPanel.Dock="Top" Text="Profiles" FontWeight="SemiBold" Margin="0,0,0,4" />
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="addProfileButton" Content="Add" />
            <Button x:Name="removeProfileButton" Content="Remove" />
            <Button x:Name="defaultProfileButton" Content="Use" ToolTip="Make this the active profile" />
          </StackPanel>
          <ListBox x:Name="profilesList" />
        </DockPanel>
        <StackPanel Grid.Column="1">
          <TextBlock Style="{StaticResource Label}" Text="Name" Margin="0,0,0,3" />
          <TextBox x:Name="profileNameBox" />
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Style="{StaticResource Label}" Text="Address" /><TextBox x:Name="profileHostBox" Margin="0,0,8,0" /></StackPanel>
            <StackPanel Grid.Column="1"><TextBlock Style="{StaticResource Label}" Text="Port" /><TextBox x:Name="profilePortBox" /></StackPanel>
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Style="{StaticResource Label}" Text="Username (optional)" /><TextBox x:Name="profileUserBox" Margin="0,0,8,0" /></StackPanel>
            <StackPanel Grid.Column="1"><TextBlock Style="{StaticResource Label}" Text="Password (optional)" /><PasswordBox x:Name="profilePasswordBox" /></StackPanel>
          </Grid>
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button x:Name="testConnectionButton" Content="Test connection" /></StackPanel>
          <TextBlock x:Name="testResultText" Style="{StaticResource Quiet}" />
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,16,0,0">
          <StackPanel Orientation="Horizontal">
            <Button x:Name="findServersButton" Content="Find servers on this network" />
            <Button x:Name="useServerButton" Content="Use selected" IsEnabled="False" />
          </StackPanel>
          <ListBox x:Name="discoveredList" Height="80" Margin="0,8,0,0" />
          <TextBlock x:Name="findResultText" Style="{StaticResource Quiet}" Text="For a VPN or another subnet, type the address above." />
        </StackPanel>
      </Grid>
    </TabItem>
    <TabItem Header="Audio" x:Name="audioTab">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="16">
        <TextBlock Text="Output device" FontWeight="SemiBold" />
        <DockPanel Margin="0,4,0,0">
          <Button x:Name="refreshDevicesButton" DockPanel.Dock="Right" Content="Refresh" Margin="8,0,0,0" />
          <ComboBox x:Name="deviceCombo" DisplayMemberPath="DisplayName">
            <ComboBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#555" Margin="4,6,0,2" /></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ComboBox.GroupStyle>
          </ComboBox>
        </DockPanel>
        <TextBlock x:Name="playerStatusText" Style="{StaticResource Quiet}" />
        <CheckBox x:Name="exclusiveBox" Content="Exclusive mode (bit-perfect, bypasses the Windows mixer)" Margin="0,14,0,0" />
        <TextBlock x:Name="exclusiveNoteText" Style="{StaticResource Quiet}" Text="Shared mode only plays tracks whose sample rate matches the Windows mixer, and is not bit-perfect." />
        <TextBlock x:Name="exclusiveWarningText" Foreground="#B26B00" TextWrapping="Wrap" Margin="0,4,0,0" Text="⚠ While WinSqueeze is playing, it has this device to itself: other apps can't play sound through it. It lets go 10 seconds after you pause or stop, or straight away when you untick this." />
        <Grid Margin="0,4,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Style="{StaticResource Label}" Text="Player name (shown on the server)" /><TextBox x:Name="playerNameBox" Margin="0,0,8,0" /></StackPanel>
          <StackPanel Grid.Column="1"><TextBlock Style="{StaticResource Label}" Text="Buffer (ms)" /><TextBox x:Name="latencyBox" ToolTip="200 ms is the safe default. Raise it if playback stutters or restarts." /></StackPanel>
        </Grid>
        <TextBlock Style="{StaticResource Label}" Text="If the chosen device is missing" />
        <ComboBox x:Name="fallbackCombo" DisplayMemberPath="DisplayName" />
        <Expander Header="Advanced" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Style="{StaticResource Label}" Text="Extra Squeezelite arguments" />
            <TextBox x:Name="extraArgumentsBox" FontFamily="Consolas" />
          </StackPanel>
        </Expander>
        <TextBlock Style="{StaticResource Quiet}" Text="Volume mode and fidelity warnings arrive in Phase 4." Margin="0,12,0,0" />
      </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="Playback" x:Name="playbackTab">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="16">
        <TextBlock x:Name="playbackPlayerText" FontWeight="SemiBold" />
        <TextBlock Style="{StaticResource Quiet}" Text="These are the player's own settings on the server, so every controller sees the same. Choose another player at the top of the main window to change its settings." />
        <TextBlock Style="{StaticResource Label}" Text="Between tracks" Margin="0,16,0,3" />
        <ComboBox x:Name="transitionTypeCombo" Width="260" HorizontalAlignment="Left">
          <ComboBoxItem Content="Nothing (gapless)" Tag="0" />
          <ComboBoxItem Content="Crossfade" Tag="1" />
          <ComboBoxItem Content="Fade in" Tag="2" />
          <ComboBoxItem Content="Fade out" Tag="3" />
          <ComboBoxItem Content="Fade out and in" Tag="4" />
        </ComboBox>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
          <TextBlock Text="Length" Width="60" VerticalAlignment="Center" />
          <Slider x:Name="transitionDurationSlider" Minimum="0" Maximum="10" Width="200" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" />
          <TextBlock x:Name="transitionDurationText" Width="60" Margin="8,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <CheckBox x:Name="transitionSmartBox" Content="Smart: no crossfade between tracks of the same album" />
        <TextBlock Style="{StaticResource Label}" Text="ReplayGain (evens out loudness using the files' ReplayGain tags)" Margin="0,16,0,3" />
        <ComboBox x:Name="replayGainCombo" Width="260" HorizontalAlignment="Left">
          <ComboBoxItem Content="Off" Tag="0" />
          <ComboBoxItem Content="Track gain" Tag="1" />
          <ComboBoxItem Content="Album gain" Tag="2" />
          <ComboBoxItem Content="Smart (album gain for whole albums)" Tag="3" />
        </ComboBox>
        <TextBlock Style="{StaticResource Quiet}" Margin="0,14,0,0" Text="On this PC, crossfades, fades and ReplayGain change the samples, so playback is no longer bit-perfect while they're on. The fidelity badge says so." />
        <TextBlock x:Name="playbackStatusText" Style="{StaticResource Quiet}" Foreground="#B26B00" />
      </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="Library &amp; cache" x:Name="libraryTab">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="16">
        <TextBlock Text="Albums are built from" FontWeight="SemiBold" />
        <RadioButton x:Name="folderAlbumsRadio" GroupName="albumSource" Content="Folders: one folder is one album or CD (CD1/CD2 subfolders join their parent)" Margin="0,6,0,0" />
        <RadioButton x:Name="tagAlbumsRadio" GroupName="albumSource" Content="Tags: Lyrion's own albums" Margin="0,4,0,0" />
        <TextBlock Text="An artist's &quot;Also appears on&quot; includes" FontWeight="SemiBold" Margin="0,16,0,0" />
        <RadioButton x:Name="anyCreditRadio" GroupName="grouping" Content="Any credit: album artist, track artist, composer, conductor or band" Margin="0,6,0,0" />
        <RadioButton x:Name="albumArtistRadio" GroupName="grouping" Content="Album artist text only" Margin="0,4,0,0" />
        <CheckBox x:Name="hideOwnComposersBox" Content="Composers list: leave out artists credited as composer only on their own albums (singer-songwriters)" Margin="0,10,0,0" />
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><TextBlock Text="Counts in Genres, Artists and other lists" VerticalAlignment="Center" Margin="0,0,10,0" /><ComboBox x:Name="listCountsBox" Width="260" /></StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><TextBlock Text="Show how many items graphically" VerticalAlignment="Center" Margin="0,0,10,0" /><ComboBox x:Name="listGraphicBox" Width="200" VerticalAlignment="Center" /><Border Background="#1B2233" CornerRadius="6" Padding="10,6" Margin="14,0,0,0"><StackPanel x:Name="listGraphicPreview" Width="230" /></Border></StackPanel>
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="160" /></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Style="{StaticResource Label}" Text="Name separators (space between each)" /><TextBox x:Name="separatorsBox" Margin="0,0,8,0" /></StackPanel>
          <StackPanel Grid.Column="1"><TextBlock Style="{StaticResource Label}" Text="Check every (minutes)" /><TextBox x:Name="refreshMinutesBox" /></StackPanel>
        </Grid>
        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
          <Button x:Name="refreshLibraryButton" Content="Refresh now" />
          <Button x:Name="rebuildLibraryButton" Content="Rebuild cache" />
          <Button x:Name="clearArtButton" Content="Clear art cache" />
        </StackPanel>
        <TextBlock x:Name="libraryStatusText" Style="{StaticResource Quiet}" />
      </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="Browsing" x:Name="browsingTab">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="16">
        <TextBlock Text="Group by options offered at the top of each view" FontWeight="SemiBold" />
        <WrapPanel x:Name="groupingChoicesPanel" Margin="0,6,0,0" />
        <TextBlock Text="Starting grouping for each area (change it any time from the view's Group menu)" FontWeight="SemiBold" Margin="0,18,0,0" />
        <Grid x:Name="defaultGroupingGrid" Margin="0,6,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="200" /></Grid.ColumnDefinitions>
        </Grid>
        <TextBlock Style="{StaticResource Quiet}" Margin="0,12,0,0" TextWrapping="Wrap" Text="Sort and View (Large, Compact or List) are remembered per area from the toolbar in the main window." />
      </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="Appearance" x:Name="appearanceTab">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="16">
        <TextBlock Style="{StaticResource Label}" Text="Skin (changes the main window as you pick)" />
        <ComboBox x:Name="skinBox" Width="260" HorizontalAlignment="Left" Margin="0,0,0,14" />
        <TextBlock Style="{StaticResource Label}" Text="Accent colour" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
          <Border x:Name="accentSwatch" Width="28" Height="22" CornerRadius="4" BorderBrush="#40FFFFFF" BorderThickness="1" Margin="0,0,8,0" />
          <Button x:Name="accentChooseButton" Content="Choose…" Padding="10,2" Margin="0,0,6,0" />
          <Button x:Name="accentResetButton" Content="Reset to default blue" Padding="10,2" />
        </StackPanel>
        <CheckBox x:Name="coverAccentBox" Content="Or take it from the playing album's cover (frosted skins)" Margin="0,0,0,8" />
        <CheckBox x:Name="coverBackdropBox" Content="Tint Now playing with the album cover's colours" Margin="0,0,0,14" />
        <TextBlock Style="{StaticResource Label}" Text="Size of everything in the main window" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
          <TextBlock Text="Scale" Width="100" VerticalAlignment="Center" />
          <Slider x:Name="uiScaleSlider" Minimum="75" Maximum="150" Width="220" IsSnapToTickEnabled="True" TickFrequency="5" VerticalAlignment="Center" />
          <TextBlock x:Name="uiScaleText" Width="50" Margin="8,0,0,0" VerticalAlignment="Center" />
          <Button x:Name="uiScaleResetButton" Content="Reset to 100%" Padding="10,2" />
        </StackPanel>
        <TextBlock Style="{StaticResource Label}" Text="Glass (frosted skins with glass on)" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
          <TextBlock Text="Transparency" Width="100" VerticalAlignment="Center" />
          <Slider x:Name="glassTransparencySlider" Minimum="0" Maximum="100" Width="220" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" />
          <TextBlock x:Name="glassTransparencyText" Width="70" Margin="8,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
          <TextBlock Text="Tint" Width="100" VerticalAlignment="Center" />
          <Slider x:Name="glassTintSlider" Minimum="0" Maximum="360" Width="220" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" />
          <Border x:Name="glassTintSwatch" Width="22" Height="16" CornerRadius="3" Margin="8,0,0,0" BorderBrush="#40FFFFFF" BorderThickness="1" />
          <TextBlock x:Name="glassTintText" Width="60" Margin="6,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <Button x:Name="glassResetButton" Content="Reset glass to default" HorizontalAlignment="Left" Padding="10,2" Margin="100,2,0,8" />
        <CheckBox x:Name="glassInactiveBox" Content="Keep the glass when WinSqueeze isn't the active window" Margin="0,0,0,14" />
        <CheckBox x:Name="glassBox" Content="Glass: let the desktop show through the window, frosted (Windows 11)" />
        <CheckBox x:Name="framelessBox" Content="Frameless window (default): no title bar or standard border. Drag from the top strip, resize from the edges. Untick for the standard Windows title bar." Margin="0,8,0,0" />
        <TextBlock Style="{StaticResource Quiet}" Margin="0,12,0,0" TextWrapping="Wrap" Text="Meter style: click the meters in Now playing to cycle VU, OLED VU and bars." />
      </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="Meters" x:Name="metersTab">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
          <TextBlock Style="{StaticResource Quiet}" TextWrapping="Wrap" Margin="0,0,0,12" Text="All meters read the exact samples sent to your DAC (with hardware volume on, that's the full-level signal, before the device's volume). Changes show live." />
          <StackPanel x:Name="metersPanel" />
          <Button x:Name="metersResetButton" Content="Reset to defaults" HorizontalAlignment="Left" Padding="10,3" Margin="0,8,0,0" />
        </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="Shortcuts" x:Name="shortcutsTab">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="16">
        <TextBlock Text="In the window" FontWeight="SemiBold" />
        <TextBlock Style="{StaticResource Quiet}" TextWrapping="Wrap" Margin="0,4,0,0" Text="Space play/pause · Ctrl+Left/Right previous/next · Ctrl+Up/Down volume · Ctrl+F search · Ctrl+N new playlist · Ctrl+Z undo (keeps going back) · Ctrl+Y or Ctrl+Shift+Z redo · Ctrl+1/2/3 window mode · Ctrl+, settings · Ctrl+Q quit · Esc back or clear selection" />
        <TextBlock Text="Keyboard media keys" FontWeight="SemiBold" Margin="0,16,0,0" />
        <TextBlock Style="{StaticResource Quiet}" TextWrapping="Wrap" Margin="0,4,0,0" Text="Play/pause, next and previous keys control WinSqueeze through the Windows media overlay." />
        <CheckBox x:Name="globalHotkeysBox" Content="Global hotkeys: Ctrl+Alt+Space play/pause, Ctrl+Alt+Left/Right previous/next, Ctrl+Alt+Up/Down volume, from any app" Margin="0,16,0,0" />
        <TextBlock x:Name="hotkeyStatusText" Style="{StaticResource Quiet}" TextWrapping="Wrap" />
      </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="Notifications" x:Name="notificationsTab">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="16">
        <CheckBox x:Name="trackToastsBox" Content="Show a notification when a new track starts" />
        <TextBlock Style="{StaticResource Quiet}" TextWrapping="Wrap" Margin="0,10,0,0" Text="Output device missing and update-ready alerts are always shown." />
      </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="Recording" x:Name="recordingTab">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="16">
        <CheckBox x:Name="recordButtonBox" Content="Show a record button while a radio station or other live stream plays" Margin="0" />
        <CheckBox x:Name="recordSplitBox" Content="Start a new file whenever the station announces a new song" />
        <RadioButton x:Name="recordFolderPerRecordingRadio" GroupName="recordFolders" Content="A folder for each recording (&quot;BBC Radio 3 - 2026-11-05, 23.05.20&quot;), songs numbered inside" Margin="0,12,0,0" />
        <RadioButton x:Name="recordFolderPerStationRadio" GroupName="recordFolders" Content="One folder per station, every file named with its date and time" Margin="0,6,0,0" />
        <TextBlock Style="{StaticResource Label}" Text="Save recordings in (one folder per recording)" Margin="0,14,0,3" />
        <DockPanel>
          <Button x:Name="openRecordFolderButton" DockPanel.Dock="Right" Content="Open" Margin="8,0,0,0" />
          <Button x:Name="chooseRecordFolderButton" DockPanel.Dock="Right" Content="Choose…" Margin="8,0,0,0" />
          <TextBox x:Name="recordFolderBox" IsReadOnly="True" VerticalContentAlignment="Center" />
        </DockPanel>
        <TextBlock Style="{StaticResource Quiet}" Margin="0,10,0,0" Text="Recordings are FLAC files of exactly what this PC's player plays, taken before the equaliser and volume, tagged with the station, song and date. They're for your own listening: broadcasts are copyright, so don't share them." />
      </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="About" x:Name="aboutTab">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
          <TextBlock x:Name="versionText" FontSize="16" FontWeight="SemiBold" />
          <TextBlock x:Name="dataFolderText" Style="{StaticResource Quiet}" />
          <TextBlock Text="Updates" FontWeight="SemiBold" Margin="0,16,0,4" />
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Channel" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="channelCombo" Width="200" Margin="0,0,12,0">
              <ComboBoxItem Content="Stable releases" Tag="stable" />
              <ComboBoxItem Content="Dev builds (every change)" Tag="dev" />
            </ComboBox>
            <CheckBox x:Name="autoUpdateBox" Content="Download updates automatically" VerticalAlignment="Center" Margin="0" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="checkNowButton" Content="Check now" />
            <Button x:Name="restartToUpdateButton" Content="Restart to update" Visibility="Collapsed" FontWeight="SemiBold" />
          </StackPanel>
          <TextBlock x:Name="updateStatusText" Style="{StaticResource Quiet}" />
          <TextBlock Text="Versions" FontWeight="SemiBold" Margin="0,16,0,4" />
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0">
              <Button x:Name="refreshVersionsButton" Content="Refresh" Margin="0,0,0,6" />
              <Button x:Name="switchVersionButton" Content="Switch to this" IsEnabled="False" />
            </StackPanel>
            <ListBox x:Name="versionsList" Height="130">
              <ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Label}" /><TextBlock Text="  ✔ running now" Foreground="#2E9E44" FontWeight="SemiBold" Visibility="{Binding CurrentVisibility}" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
          <TextBlock x:Name="versionNotesText" Style="{StaticResource Quiet}" />
          <TextBlock Margin="0,4,0,0"><Hyperlink x:Name="versionDiscussionLink">Comments for this version</Hyperlink></TextBlock>
          <TextBlock Style="{StaticResource Quiet}" Margin="0,16,0,0" Text="WinSqueeze is free software under the GNU GPL v3. It bundles Squeezelite 2.0.0-1610 (Adrian Smith, Ralph Irving), GPL v3; its licence is in the squeezelite folder next to WinSqueeze.exe." />
          <TextBlock Margin="0,4,0,0"><Hyperlink x:Name="squeezeliteSourceLink" NavigateUri="https://github.com/ralph-irving/squeezelite">Squeezelite source code</Hyperlink></TextBlock>
          <StackPanel Orientation="Horizontal" Margin="0,16,0,0"><Button x:Name="openLogsButton" Content="Open logs folder" /></StackPanel>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
  </TabControl>
</Window>
