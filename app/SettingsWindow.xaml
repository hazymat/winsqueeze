<Window x:Class="WinSqueeze.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinSqueeze Settings" Icon="Assets/WinSqueeze.ico" Width="820" Height="580" MinWidth="680" MinHeight="460" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style TargetType="TextBlock" x:Key="Label"><Setter Property="Margin" Value="0,10,0,3" /></Style>
    <Style TargetType="TextBlock" x:Key="Quiet"><Setter Property="Foreground" Value="#666" /><Setter Property="FontSize" Value="12" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Margin" Value="0,4,0,0" /></Style>
    <!-- Each page is a column of white cards; explanations sit in tinted callouts, longer ones in expandable panels -->
    <Style TargetType="Border" x:Key="Card"><Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="#E3E5E8" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="8" /><Setter Property="Padding" Value="16,12,16,14" /><Setter Property="Margin" Value="0,0,0,12" /></Style>
    <Style TargetType="TextBlock" x:Key="CardTitle"><Setter Property="FontSize" Value="14" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Margin" Value="0,0,0,4" /></Style>
    <Style TargetType="Border" x:Key="Callout"><Setter Property="Background" Value="#EEF4FC" /><Setter Property="BorderBrush" Value="#D3E2F5" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="6" /><Setter Property="Padding" Value="10,8" /><Setter Property="Margin" Value="0,10,0,0" /></Style>
    <Style TargetType="Border" x:Key="Warning" BasedOn="{StaticResource Callout}"><Setter Property="Background" Value="#FFF6E5" /><Setter Property="BorderBrush" Value="#F0DCAF" /></Style>
    <Style TargetType="TextBlock" x:Key="CalloutIcon"><Setter Property="FontFamily" Value="Segoe MDL2 Assets" /><Setter Property="FontSize" Value="14" /><Setter Property="Foreground" Value="#2F7FD8" /><Setter Property="Margin" Value="0,1,10,0" /><Setter Property="Text" Value="&#xE946;" /><Setter Property="DockPanel.Dock" Value="Left" /></Style>
    <Style TargetType="TextBlock" x:Key="WarningIcon" BasedOn="{StaticResource CalloutIcon}"><Setter Property="Foreground" Value="#B26B00" /><Setter Property="Text" Value="&#xE7BA;" /></Style>
    <Style TargetType="TextBlock" x:Key="CalloutText"><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Foreground" Value="#2B3A4E" /><Setter Property="LineHeight" Value="19" /></Style>
    <Style TargetType="Expander" x:Key="More"><Setter Property="Margin" Value="0,10,0,0" /><Setter Property="Foreground" Value="#2F6FB8" /></Style>
    <!-- Keycaps for the shortcut tables -->
    <Style TargetType="Border" x:Key="Keycap"><Setter Property="Background" Value="#F3F4F6" /><Setter Property="BorderBrush" Value="#CDD1D7" /><Setter Property="BorderThickness" Value="1,1,1,2" /><Setter Property="CornerRadius" Value="4" /><Setter Property="Padding" Value="6,1" /><Setter Property="Margin" Value="0,2,4,2" /></Style>
    <Style TargetType="Button"><Setter Property="Padding" Value="12,4" /><Setter Property="Margin" Value="0,0,8,0" /></Style>
    <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,8,0,0" /></Style>
    <!-- Settings pages in a left sidebar, grouped under small section headings; the page's name heads its content -->
    <Style TargetType="TabControl">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border Background="#F3F3F3" BorderBrush="#E2E2E2" BorderThickness="0,0,1,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel IsItemsHost="True" Margin="8,10" /></ScrollViewer></Border>
          <DockPanel Grid.Column="1" Background="#F7F8FA"><TextBlock DockPanel.Dock="Top" Text="{Binding SelectedItem.Header, RelativeSource={RelativeSource TemplatedParent}}" FontSize="22" FontWeight="SemiBold" Margin="20,16,20,4" />
            <ContentPresenter ContentSource="SelectedContent" /></DockPanel>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
        <Border x:Name="itemBorder" Background="Transparent" CornerRadius="4" Padding="10,6" Margin="0,1"><Grid>
          <Border x:Name="selectedBar" Width="3" CornerRadius="1.5" Background="#2F7FD8" HorizontalAlignment="Left" Margin="-8,2,0,2" Visibility="Collapsed" />
          <ContentPresenter ContentSource="Header" /></Grid></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="itemBorder" Property="Background" Value="#E6E6E6" /></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="itemBorder" Property="Background" Value="#DDE8F6" /><Setter TargetName="selectedBar" Property="Visibility" Value="Visible" /><Setter Property="FontWeight" Value="SemiBold" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TabItem" x:Key="SectionHeader">
      <Setter Property="IsEnabled" Value="False" /><Setter Property="Focusable" Value="False" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
        <ContentPresenter ContentSource="Header" TextElement.Foreground="#888" TextElement.FontSize="11" TextElement.FontWeight="SemiBold" Margin="10,12,0,3" />
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <TabControl x:Name="settingsTabs">
    <TabItem Header="Server" Style="{StaticResource SectionHeader}" />
    <TabItem Header="Servers" x:Name="serversTab">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="20,8,20,16">
        <Border Style="{StaticResource Card}">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <DockPanel Margin="0,0,16,0">
              <TextBlock DockPanel.Dock="Top" Text="Profiles" Style="{StaticResource CardTitle}" />
              <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="addProfileButton" Content="Add" />
                <Button x:Name="removeProfileButton" Content="Remove" />
                <Button x:Name="defaultProfileButton" Content="Use" ToolTip="Make this the active profile" />
              </StackPanel>
              <ListBox x:Name="profilesList" MinHeight="150" />
            </DockPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Style="{StaticResource Label}" Text="Name" Margin="0,0,0,3" />
              <TextBox x:Name="profileNameBox" />
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Style="{StaticResource Label}" Text="Address" /><TextBox x:Name="profileHostBox" Margin="0,0,8,0" /></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Style="{StaticResource Label}" Text="Port" /><TextBox x:Name="profilePortBox" /></StackPanel>
              </Grid>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Style="{StaticResource Label}" Text="Username (optional)" /><TextBox x:Name="profileUserBox" Margin="0,0,8,0" /></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Style="{StaticResource Label}" Text="Password (optional)" /><PasswordBox x:Name="profilePasswordBox" /></StackPanel>
              </Grid>
              <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button x:Name="testConnectionButton" Content="Test connection" /></StackPanel>
              <TextBlock x:Name="testResultText" Style="{StaticResource Quiet}" />
            </StackPanel>
          </Grid>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Find a server" Style="{StaticResource CardTitle}" />
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
              <Button x:Name="findServersButton" Content="Find servers on this network" />
              <Button x:Name="useServerButton" Content="Use selected" IsEnabled="False" />
            </StackPanel>
            <ListBox x:Name="discoveredList" Height="80" Margin="0,8,0,0" />
            <TextBlock x:Name="findResultText" Style="{StaticResource Quiet}" Text="For a VPN or another subnet, type the address above." />
          </StackPanel>
        </Border>
      </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="Library" x:Name="serverLibraryTab">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="20,8,20,16">
        <!-- Scan status: polled every 2 s while this page is open -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <DockPanel>
              <Button x:Name="stopScanButton" DockPanel.Dock="Right" Content="Stop scan" Margin="8,0,0,0" Visibility="Collapsed" VerticalAlignment="Top" />
              <TextBlock x:Name="scanGlyph" DockPanel.Dock="Left" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#2E7D32" Text="&#xE73E;" Margin="0,2,10,0" />
              <StackPanel>
                <TextBlock x:Name="scanHeadlineText" Style="{StaticResource CardTitle}" Text="Checking the server" />
                <TextBlock x:Name="scanDetailText" Style="{StaticResource Quiet}" Margin="0,0,0,0" />
              </StackPanel>
            </DockPanel>
            <StackPanel x:Name="scanRunningPanel" Visibility="Collapsed" Margin="0,10,0,0">
              <ProgressBar x:Name="scanBar" Height="8" Maximum="100" Foreground="#2F7FD8" Background="#E8EBEF" BorderThickness="0" />
              <TextBlock x:Name="scanInfoText" Style="{StaticResource Quiet}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
              <StackPanel x:Name="scanStepsPanel" Margin="0,8,0,0" />
            </StackPanel>
            <Border x:Name="scanAddedCallout" Style="{StaticResource Callout}" Visibility="Collapsed"><DockPanel>
              <Button x:Name="showNewMusicButton" DockPanel.Dock="Right" Content="Show in New music" VerticalAlignment="Top" Margin="8,0,0,0" />
              <TextBlock Style="{StaticResource CalloutIcon}" />
              <StackPanel><TextBlock x:Name="scanAddedTitle" FontWeight="SemiBold" Foreground="#2B3A4E" /><TextBlock x:Name="scanAddedList" Style="{StaticResource CalloutText}" Margin="0,2,0,0" /></StackPanel>
            </DockPanel></Border>
            <Border x:Name="scanFailedCallout" Style="{StaticResource Warning}" Visibility="Collapsed"><DockPanel><TextBlock Style="{StaticResource WarningIcon}" /><TextBlock x:Name="scanFailedText" Style="{StaticResource CalloutText}" /></DockPanel></Border>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Scan the server's library" Style="{StaticResource CardTitle}" />
            <Border Style="{StaticResource Callout}" Margin="0,4,0,0"><DockPanel><TextBlock Style="{StaticResource CalloutIcon}" /><TextBlock Style="{StaticResource CalloutText}" Text="After adding or retagging music, scan so Lyrion and every player see the changes. WinSqueeze picks them up when the scan finishes." /></DockPanel></Border>
            <WrapPanel Margin="0,12,0,0">
              <Button x:Name="rescanButton" Content="Scan for changes" Margin="0,0,8,6" />
              <Button x:Name="rescanPlaylistsButton" Content="Playlists only" Margin="0,0,8,6" />
              <Button x:Name="wipeCacheButton" Content="Clear and rescan everything…" Margin="0,0,8,6" />
            </WrapPanel>
            <TextBlock x:Name="scanActionText" Style="{StaticResource Quiet}" />
            <Expander Header="Which scan?" Style="{StaticResource More}">
              <Border Style="{StaticResource Callout}" Margin="0,6,0,0"><Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                <TextBlock Text="Scan for changes" FontWeight="SemiBold" Margin="0,2,16,4" /><TextBlock Grid.Column="1" Style="{StaticResource CalloutText}" Margin="0,2,0,4" Text="New, changed and deleted files. Quickest; use this normally." />
                <TextBlock Grid.Row="1" Text="Playlists only" FontWeight="SemiBold" Margin="0,2,16,4" /><TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource CalloutText}" Margin="0,2,0,4" Text="Just the server's playlist folder." />
                <TextBlock Grid.Row="2" Text="Clear and rescan" FontWeight="SemiBold" Margin="0,2,16,0" /><TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource CalloutText}" Margin="0,2,0,0" Text="Empties the server's library and reads every file again. Slow; for when the library looks wrong. Players see a partial library until it finishes." />
              </Grid></Border>
            </Expander>
          </StackPanel>
        </Border>
      </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="Player" Style="{StaticResource SectionHeader}" />
    <TabItem Header="Audio" x:Name="audioTab">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="20,8,20,16">
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Output device" Style="{StaticResource CardTitle}" />
            <DockPanel Margin="0,4,0,0">
              <Button x:Name="refreshDevicesButton" DockPanel.Dock="Right" Content="Refresh" Margin="8,0,0,0" />
              <ComboBox x:Name="deviceCombo" DisplayMemberPath="DisplayName">
                <ComboBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#555" Margin="4,6,0,2" /></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ComboBox.GroupStyle>
              </ComboBox>
            </DockPanel>
            <TextBlock x:Name="playerStatusText" Style="{StaticResource Quiet}" />
            <TextBlock x:Name="fallbackLabel" Style="{StaticResource Label}" Text="If the chosen device is missing" />
            <ComboBox x:Name="fallbackCombo" DisplayMemberPath="DisplayName" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Exclusive mode" Style="{StaticResource CardTitle}" />
            <CheckBox x:Name="exclusiveBox" Content="Exclusive mode (bit-perfect, bypasses the Windows mixer)" Margin="0,4,0,0" />
            <TextBlock x:Name="exclusiveNoteText" Style="{StaticResource Quiet}" Text="Off (default): plays through the Windows mixer, which resamples to its own rate, so it isn't bit-perfect. On: bit-perfect, but some sound card drivers refuse it; if yours does, WinSqueeze switches back to shared and says so." />
            <Border x:Name="exclusiveWarningText" Style="{StaticResource Warning}"><DockPanel><TextBlock Style="{StaticResource WarningIcon}" /><TextBlock Style="{StaticResource CalloutText}" Text="While WinSqueeze is playing, it has this device to itself: other apps can't play sound through it. It lets go 10 seconds after you pause or stop, or straight away when you untick this." /></DockPanel></Border>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Player" Style="{StaticResource CardTitle}" />
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Style="{StaticResource Label}" Text="Name (shown on the server)" /><TextBox x:Name="playerNameBox" Margin="0,0,8,0" /></StackPanel>
              <StackPanel Grid.Column="1"><TextBlock Style="{StaticResource Label}" Text="Buffer (ms)" /><TextBox x:Name="latencyBox" ToolTip="200 ms is the safe default. Raise it if playback stutters or restarts." /></StackPanel>
            </Grid>
            <Expander Header="Advanced" Style="{StaticResource More}">
              <StackPanel>
                <TextBlock Style="{StaticResource Label}" Text="Extra Squeezelite arguments" />
                <TextBox x:Name="extraArgumentsBox" FontFamily="Consolas" />
              </StackPanel>
            </Expander>
          </StackPanel>
        </Border>
      </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="Playback" x:Name="playbackTab">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="20,8,20,16">
        <Border Style="{StaticResource Callout}" Margin="0,0,0,12"><DockPanel><TextBlock Style="{StaticResource CalloutIcon}" /><StackPanel><TextBlock x:Name="playbackPlayerText" FontWeight="SemiBold" Foreground="#2B3A4E" /><TextBlock Style="{StaticResource CalloutText}" Text="These are the player's own settings on the server, so every controller sees the same. Choose another player at the top of the main window to change its settings." /></StackPanel></DockPanel></Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Between tracks" Style="{StaticResource CardTitle}" />
            <ComboBox x:Name="transitionTypeCombo" Width="260" HorizontalAlignment="Left" Margin="0,4,0,0">
              <ComboBoxItem Content="Nothing (gapless)" Tag="0" />
              <ComboBoxItem Content="Crossfade" Tag="1" />
              <ComboBoxItem Content="Fade in" Tag="2" />
              <ComboBoxItem Content="Fade out" Tag="3" />
              <ComboBoxItem Content="Fade out and in" Tag="4" />
            </ComboBox>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <TextBlock Text="Length" Width="60" VerticalAlignment="Center" />
              <Slider x:Name="transitionDurationSlider" Minimum="0" Maximum="10" Width="200" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" />
              <TextBlock x:Name="transitionDurationText" Width="60" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <CheckBox x:Name="transitionSmartBox" Content="Smart: no crossfade between tracks of the same album" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="ReplayGain" Style="{StaticResource CardTitle}" />
            <TextBlock Style="{StaticResource Quiet}" Margin="0,0,0,6" Text="Evens out loudness using the files' ReplayGain tags." />
            <ComboBox x:Name="replayGainCombo" Width="260" HorizontalAlignment="Left">
              <ComboBoxItem Content="Off" Tag="0" />
              <ComboBoxItem Content="Track gain" Tag="1" />
              <ComboBoxItem Content="Album gain" Tag="2" />
              <ComboBoxItem Content="Smart (album gain for whole albums)" Tag="3" />
            </ComboBox>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Callout}" Margin="0"><DockPanel><TextBlock Style="{StaticResource CalloutIcon}" /><TextBlock Style="{StaticResource CalloutText}" Text="On this PC, crossfades, fades and ReplayGain change the samples, so playback is no longer bit-perfect while they're on. The fidelity badge says so." /></DockPanel></Border>
        <TextBlock x:Name="playbackStatusText" Style="{StaticResource Quiet}" Foreground="#B26B00" />
      </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="Now playing views" x:Name="nowPlayingViewsTab">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="20,8,20,16">
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Tabs" Style="{StaticResource CardTitle}" />
            <TextBlock Style="{StaticResource Quiet}" FontSize="13" Margin="0,0,0,8" Text="Additional tabs next to &quot;Up next&quot;" />
            <Border BorderBrush="#E3E5E8" BorderThickness="1" CornerRadius="6" ClipToBounds="True"><StackPanel x:Name="infoTabsList" /></Border>
            <CheckBox x:Name="timelineBox" Margin="0,10,0,0" Content="Timeline under Artist: albums, bands, labels and awards" />
            <CheckBox x:Name="creditsBox" Margin="0,6,0,0" Content="Credits under Album: who played, wrote and produced it" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Sources" Style="{StaticResource CardTitle}" />
            <TextBlock Style="{StaticResource Quiet}" FontSize="13" Margin="0,0,0,8" Text="Tried from the top; the first with a result is shown" />
            <UniformGrid x:Name="infoSourcesGrid" Columns="3" />
            <Border Style="{StaticResource Callout}"><DockPanel><TextBlock Style="{StaticResource CalloutIcon}" /><TextBlock Style="{StaticResource CalloutText}" Text="Online sources are sent the artist, album and track name only" /></DockPanel></Border>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0">
          <StackPanel>
            <DockPanel><TextBlock DockPanel.Dock="Right" Text="optional" Foreground="#888" /><TextBlock Text="Last.fm" Style="{StaticResource CardTitle}" /></DockPanel>
            <TextBlock Style="{StaticResource Quiet}" FontSize="13" Margin="0,0,0,8">Free key from <Hyperlink x:Name="lastFmLink" NavigateUri="https://www.last.fm/api/account/create">last.fm/api</Hyperlink>. Adds Last.fm as a source for Artist and Album</TextBlock>
            <DockPanel><TextBlock Text="API key" Width="110" VerticalAlignment="Center" /><TextBox x:Name="lastFmKeyBox" Padding="4,3" /></DockPanel>
          </StackPanel>
        </Border>
      </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="Recording" x:Name="recordingTab">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="20,8,20,16">
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Recording radio" Style="{StaticResource CardTitle}" />
            <CheckBox x:Name="recordButtonBox" Content="Show a record button while a radio station or other live stream plays" Margin="0,4,0,0" />
            <CheckBox x:Name="recordSplitBox" Content="Start a new file whenever the station announces a new song" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Where recordings go" Style="{StaticResource CardTitle}" />
            <RadioButton x:Name="recordFolderPerRecordingRadio" GroupName="recordFolders" Margin="0,4,0,0"><TextBlock TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="A folder for each recording" /><Run Foreground="#666" Text="  (&quot;BBC Radio 3 - 2026-11-05, 23.05.20&quot;), songs numbered inside" /></TextBlock></RadioButton>
            <RadioButton x:Name="recordFolderPerStationRadio" GroupName="recordFolders" Margin="0,6,0,0"><TextBlock TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="One folder per station" /><Run Foreground="#666" Text="  every file named with its date and time" /></TextBlock></RadioButton>
            <TextBlock Style="{StaticResource Label}" Text="Save recordings in" Margin="0,14,0,3" />
            <DockPanel>
              <Button x:Name="openRecordFolderButton" DockPanel.Dock="Right" Content="Open" Margin="8,0,0,0" />
              <Button x:Name="chooseRecordFolderButton" DockPanel.Dock="Right" Content="Choose…" Margin="8,0,0,0" />
              <TextBox x:Name="recordFolderBox" IsReadOnly="True" VerticalContentAlignment="Center" />
            </DockPanel>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Warning}" Margin="0"><DockPanel><TextBlock Style="{StaticResource WarningIcon}" /><TextBlock Style="{StaticResource CalloutText}" Text="Recordings are FLAC files of exactly what this PC's player plays, taken before the equaliser and volume, tagged with the station, song and date. They're for your own listening: broadcasts are copyright, so don't share them." /></DockPanel></Border>
      </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="Library" Style="{StaticResource SectionHeader}" />
    <TabItem Header="Library &amp; cache" x:Name="libraryTab">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="20,8,20,16">
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Albums are built from" Style="{StaticResource CardTitle}" />
            <RadioButton x:Name="folderAlbumsRadio" GroupName="albumSource" Margin="0,4,0,0"><TextBlock TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="Folders" /><Run Foreground="#666" Text="  one folder is one album or CD (CD1/CD2 subfolders join their parent)" /></TextBlock></RadioButton>
            <RadioButton x:Name="tagAlbumsRadio" GroupName="albumSource" Margin="0,6,0,0"><TextBlock TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="Tags" /><Run Foreground="#666" Text="  Lyrion's own albums" /></TextBlock></RadioButton>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="An artist's &quot;Also appears on&quot; includes" Style="{StaticResource CardTitle}" />
            <RadioButton x:Name="anyCreditRadio" GroupName="grouping" Margin="0,4,0,0"><TextBlock TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="Any credit" /><Run Foreground="#666" Text="  album artist, track artist, composer, conductor or band" /></TextBlock></RadioButton>
            <RadioButton x:Name="albumArtistRadio" GroupName="grouping" Margin="0,6,0,0"><TextBlock><Run FontWeight="SemiBold" Text="Album artist text only" /></TextBlock></RadioButton>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Names" Style="{StaticResource CardTitle}" />
            <Grid Margin="0,4,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
              <TextBlock Text="Composer and conductor names" VerticalAlignment="Center" />
              <ComboBox x:Name="nameOrderBox" Grid.Column="1" Width="260" HorizontalAlignment="Left"><ComboBoxItem Tag="surname" Content="Surname, Forename (Kapustin, Nikolai)" /><ComboBoxItem Tag="forename" Content="Forename Surname (Nikolai Kapustin)" /></ComboBox>
              <TextBlock Grid.Row="1" Text="Name separators" VerticalAlignment="Center" Margin="0,8,0,0" />
              <TextBox x:Name="separatorsBox" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" ToolTip="Space between each" />
            </Grid>
            <CheckBox x:Name="readSurnameFirstBox" Content="Read composer and conductor tags like &quot;Kapustin, Nikolai&quot; as one person" />
            <CheckBox x:Name="hideOwnComposersBox" Content="Composers list: leave out artists credited as composer only on their own albums (singer-songwriters)" />
            <Expander Header="How names are split" Style="{StaticResource More}">
              <Border Style="{StaticResource Callout}" Margin="0,6,0,0"><Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                <TextBlock Text="Artists" FontWeight="SemiBold" Margin="0,2,16,4" /><TextBlock Grid.Column="1" Style="{StaticResource CalloutText}" Margin="0,2,0,4" Text="Split on the separators, never on commas: &quot;Earth, Wind &amp; Fire&quot; stays whole." />
                <TextBlock Grid.Row="1" Text="Composers, conductors" FontWeight="SemiBold" Margin="0,2,16,4" /><TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource CalloutText}" Margin="0,2,0,4" Text="Also split on commas, except &quot;Surname, Forename&quot; (one word before the comma) when the tickbox above is on." />
                <TextBlock Grid.Row="2" Text="Word separators" FontWeight="SemiBold" Margin="0,2,16,0" /><TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource CalloutText}" Margin="0,2,0,0" Text="Words like &quot;and&quot; or &quot;with&quot; only split when they have spaces round them." />
              </Grid></Border>
            </Expander>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Lists" Style="{StaticResource CardTitle}" />
            <Grid Margin="0,4,0,0">
              <!-- Preview sits under its dropdown at the same width: a third column was squeezed to ~50 px and clipped the dots and counts -->
              <Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
              <TextBlock Text="Counts in Genres, Artists and other lists" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
              <ComboBox x:Name="listCountsBox" Grid.Column="1" Width="300" HorizontalAlignment="Left" VerticalAlignment="Center" />
              <TextBlock Grid.Row="1" Text="Show how many items graphically" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,8,12,0" />
              <ComboBox x:Name="listGraphicBox" Grid.Row="1" Grid.Column="1" Width="300" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,8,0,0" />
              <Border Grid.Row="2" Grid.Column="1" Width="300" HorizontalAlignment="Left" Background="#1B2233" CornerRadius="6" Padding="10,6" Margin="0,8,0,0"><StackPanel x:Name="listGraphicPreview" /></Border>
            </Grid>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Cache" Style="{StaticResource CardTitle}" />
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0"><TextBlock Text="Check the server for changes every" VerticalAlignment="Center" Margin="0,0,8,0" /><TextBox x:Name="refreshMinutesBox" Width="50" /><TextBlock Text="minutes" VerticalAlignment="Center" Margin="8,0,0,0" /></StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
              <Button x:Name="refreshLibraryButton" Content="Refresh now" />
              <Button x:Name="rebuildLibraryButton" Content="Rebuild cache" />
              <Button x:Name="clearArtButton" Content="Clear art cache" />
            </StackPanel>
            <TextBlock x:Name="libraryStatusText" Style="{StaticResource Quiet}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Library health" Style="{StaticResource CardTitle}" />
            <Border Style="{StaticResource Callout}" Margin="0,4,0,0"><DockPanel><TextBlock Style="{StaticResource CalloutIcon}" /><TextBlock Style="{StaticResource CalloutText}" Text="A report of albums missing cover art or composers, duplicate albums, inconsistent tags and names, and files with damaged frames found while playing. Each entry opens the album, so you can see what to fix in your tagger. WinSqueeze never changes your files." /></DockPanel></Border>
            <TextBlock x:Name="damagedCountText" Style="{StaticResource Quiet}" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button x:Name="openHealthButton" Content="Open library health" /></StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="Browsing" x:Name="browsingTab">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="20,8,20,16">
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Group by options" Style="{StaticResource CardTitle}" />
            <TextBlock Style="{StaticResource Quiet}" Margin="0,0,0,4" Text="Offered in the Group menu at the top of each view." />
            <WrapPanel x:Name="groupingChoicesPanel" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Starting grouping for each area" Style="{StaticResource CardTitle}" />
            <TextBlock Style="{StaticResource Quiet}" Margin="0,0,0,4" Text="Change it any time from the view's Group menu." />
            <Grid x:Name="defaultGroupingGrid">
              <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="200" /></Grid.ColumnDefinitions>
            </Grid>
            <Border Style="{StaticResource Callout}"><DockPanel><TextBlock Style="{StaticResource CalloutIcon}" /><TextBlock Style="{StaticResource CalloutText}" Text="Sort and View are remembered per area from the toolbar in the main window." /></DockPanel></Border>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Custom views" Style="{StaticResource CardTitle}" />
            <TextBlock Style="{StaticResource Quiet}" Text="Your own browse paths, like Genre → Composer → albums, limited to the genres you choose." />
            <Expander Header="How custom views differ from the built-in lists" Style="{StaticResource More}">
              <Border Style="{StaticResource Callout}" Margin="0,6,0,0"><DockPanel><TextBlock Style="{StaticResource CalloutIcon}" /><TextBlock x:Name="customViewsText" Style="{StaticResource CalloutText}" Text="The built-in lists browse your whole library one way: pick a composer, see their albums. A custom view first narrows the library to genres you choose, then steps through the order you choose, such as Genre, then Composer, then albums. So a Classical view lists only classical composers, without the pop songwriters credited on your other albums, and lets you ask questions the built-in lists can't, like which composers you have in Choral, or which genres you have of Bach." /></DockPanel></Border>
            </Expander>
            <Button x:Name="customViewsButton" Content="Edit custom views…" HorizontalAlignment="Left" Margin="0,12,0,0" />
          </StackPanel>
        </Border>
      </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="Look" Style="{StaticResource SectionHeader}" />
    <TabItem Header="Appearance" x:Name="appearanceTab">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="20,8,20,16">
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Skin" Style="{StaticResource CardTitle}" />
            <TextBlock Style="{StaticResource Quiet}" Margin="0,0,0,6" Text="The main window changes as you pick." />
            <ComboBox x:Name="skinBox" Width="260" HorizontalAlignment="Left" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Colour" Style="{StaticResource CardTitle}" />
            <StackPanel Orientation="Horizontal" Margin="0,4,0,6">
              <Border x:Name="accentSwatch" Width="28" Height="22" CornerRadius="4" BorderBrush="#40FFFFFF" BorderThickness="1" Margin="0,0,8,0" />
              <Button x:Name="accentChooseButton" Content="Choose…" Margin="0,0,6,0" />
              <Button x:Name="accentResetButton" Content="Reset to default blue" />
            </StackPanel>
            <CheckBox x:Name="coverAccentBox" Content="Or take the accent from the playing album's cover (frosted skins)" />
            <CheckBox x:Name="coverBackdropBox" Content="Tint Now playing with the album cover's colours" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Size" Style="{StaticResource CardTitle}" />
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
              <TextBlock Text="Scale" Width="100" VerticalAlignment="Center" />
              <Slider x:Name="uiScaleSlider" Minimum="75" Maximum="150" Width="220" IsSnapToTickEnabled="True" TickFrequency="5" VerticalAlignment="Center" />
              <TextBlock x:Name="uiScaleText" Width="50" Margin="8,0,0,0" VerticalAlignment="Center" />
              <Button x:Name="uiScaleResetButton" Content="Reset to 100%" />
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Glass" Style="{StaticResource CardTitle}" />
            <CheckBox x:Name="glassBox" Content="Let the desktop show through the window, frosted (Windows 11)" Margin="0,4,0,8" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
              <TextBlock Text="Transparency" Width="100" VerticalAlignment="Center" />
              <Slider x:Name="glassTransparencySlider" Minimum="0" Maximum="100" Width="220" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" />
              <TextBlock x:Name="glassTransparencyText" Width="70" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
              <TextBlock Text="Tint" Width="100" VerticalAlignment="Center" />
              <Slider x:Name="glassTintSlider" Minimum="0" Maximum="360" Width="220" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" />
              <Border x:Name="glassTintSwatch" Width="22" Height="16" CornerRadius="3" Margin="8,0,0,0" BorderBrush="#40FFFFFF" BorderThickness="1" />
              <TextBlock x:Name="glassTintText" Width="60" Margin="6,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <Button x:Name="glassResetButton" Content="Reset glass to default" HorizontalAlignment="Left" Margin="100,2,0,0" />
            <CheckBox x:Name="glassInactiveBox" Content="Keep the glass when WinSqueeze isn't the active window" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Window" Style="{StaticResource CardTitle}" />
            <CheckBox x:Name="framelessBox" Content="Frameless window (default)" Margin="0,4,0,0" />
            <TextBlock Style="{StaticResource Quiet}" Margin="22,2,0,0" Text="No title bar or standard border: drag from the top strip, resize from the edges. Untick for the standard Windows title bar." />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Callout}" Margin="0"><DockPanel><TextBlock Style="{StaticResource CalloutIcon}" /><TextBlock Style="{StaticResource CalloutText}" Text="Meter style: click the meters in Now playing to cycle through the styles ticked in Meters." /></DockPanel></Border>
      </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="Meters" x:Name="metersTab">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,8,20,16">
          <Border Style="{StaticResource Callout}" Margin="0,0,0,12"><DockPanel><TextBlock Style="{StaticResource CalloutIcon}" /><TextBlock Style="{StaticResource CalloutText}" Text="All meters read the exact samples sent to your DAC (with hardware volume on, that's the full-level signal, before the device's volume). Changes show live." /></DockPanel></Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Click the meters to cycle" Style="{StaticResource CardTitle}" />
              <TextBlock Style="{StaticResource Quiet}" Margin="0,2,0,8" TextWrapping="Wrap" Text="Tick the styles a click moves through, in this order. With just one ticked, a click taps the meter instead." />
              <Border BorderBrush="#E3E5E8" BorderThickness="1" CornerRadius="6" ClipToBounds="True"><StackPanel x:Name="meterStylesList" /></Border>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <StackPanel x:Name="metersPanel" />
              <Button x:Name="metersResetButton" Content="Reset to defaults" HorizontalAlignment="Left" Margin="0,8,0,0" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="App" Style="{StaticResource SectionHeader}" />
    <TabItem Header="General" x:Name="generalTab">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="20,8,20,16">
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Starting and closing" Style="{StaticResource CardTitle}" />
            <!-- Start with Windows + Resume playing together mean music can start on boot: an amber bracket joins the pair and a warning sits under it -->
            <Grid HorizontalAlignment="Left"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <CheckBox x:Name="startWithWindowsBox" Content="Start with Windows" Margin="0,4,0,0" />
              <CheckBox x:Name="resumeOnStartupBox" Grid.Row="1" Content="Resume playing on startup (if the server is still playing to this player)" />
              <Border x:Name="autoPlayBracket" Grid.Column="1" Grid.RowSpan="2" Width="8" Margin="10,12,0,8" BorderBrush="#D08A00" BorderThickness="0,1.5,1.5,1.5" CornerRadius="0,3,3,0" />
            </Grid>
            <Border x:Name="autoPlayWarning" Style="{StaticResource Warning}" Margin="0,8,0,2"><DockPanel><TextBlock Style="{StaticResource WarningIcon}" /><TextBlock Style="{StaticResource CalloutText}" Text="Music may start playing as soon as your PC restarts, if the server was still playing to this player when it shut down." /></DockPanel></Border>
            <CheckBox x:Name="resumeAfterUpdateBox" Content="Resume playing after an update restarts WinSqueeze" />
            <CheckBox x:Name="startMinimisedBox" Content="Start minimised to tray" />
            <CheckBox x:Name="closeHidesBox" Content="Close (X) keeps WinSqueeze running in the tray (otherwise it quits)" />
            <TextBlock Style="{StaticResource Label}" Text="When another Squeezelite is running at launch" Margin="0,14,0,3" />
            <ComboBox x:Name="otherSqueezeliteCombo" Width="320" HorizontalAlignment="Left">
              <ComboBoxItem Content="Ask me" Tag="Ask" />
              <ComboBoxItem Content="Always stop it" Tag="Stop" />
              <ComboBoxItem Content="Leave it running" Tag="Leave" />
            </ComboBox>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Hints" Style="{StaticResource CardTitle}" />
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0"><CheckBox x:Name="showHintsBox" Content="Show hints around the app" VerticalAlignment="Center" Margin="0" /><Button x:Name="resetHintsButton" Content="Show all hints again" Margin="12,0,0,0" /></StackPanel>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Settings file" Style="{StaticResource CardTitle}" />
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
              <Button x:Name="exportSettingsButton" Content="Export settings…" />
              <Button x:Name="importSettingsButton" Content="Import settings…" />
            </StackPanel>
            <TextBlock x:Name="settingsFileText" Style="{StaticResource Quiet}" Text="Exports everything except passwords, as a JSON file you can keep or copy to another PC." />
          </StackPanel>
        </Border>
      </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="Shortcuts" x:Name="shortcutsTab">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="20,8,20,16">
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="In the window" Style="{StaticResource CardTitle}" />
            <Grid x:Name="windowShortcutsTable" Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions></Grid>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="With items selected" Style="{StaticResource CardTitle}" />
            <Grid x:Name="selectionShortcutsTable" Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions></Grid>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="From any app" Style="{StaticResource CardTitle}" />
            <TextBlock Style="{StaticResource Quiet}" Margin="0,0,0,6" Text="Keyboard media keys (play/pause, next, previous) always control WinSqueeze through the Windows media overlay." />
            <CheckBox x:Name="globalHotkeysBox" Content="Global hotkeys" Margin="0,0,0,4" />
            <Grid x:Name="globalShortcutsTable"><Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions></Grid>
            <TextBlock x:Name="hotkeyStatusText" Style="{StaticResource Quiet}" />
          </StackPanel>
        </Border>
      </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="Notifications" x:Name="notificationsTab">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="20,8,20,16">
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Notifications" Style="{StaticResource CardTitle}" />
            <CheckBox x:Name="trackToastsBox" Content="Show a notification when a new track starts" Margin="0,4,0,0" />
            <Border Style="{StaticResource Callout}"><DockPanel><TextBlock Style="{StaticResource CalloutIcon}" /><TextBlock Style="{StaticResource CalloutText}" Text="Output device missing and update-ready alerts are always shown." /></DockPanel></Border>
          </StackPanel>
        </Border>
      </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="About" x:Name="aboutTab">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,8,20,16">
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock x:Name="versionText" FontSize="16" FontWeight="SemiBold" />
              <TextBlock x:Name="dataFolderText" Style="{StaticResource Quiet}" />
              <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button x:Name="openLogsButton" Content="Open logs folder" /><Button x:Name="copyDiagnosticsButton" Content="Copy diagnostics" Margin="8,0,0,0" ToolTip="Copies version, Windows, server, player and audio details plus the end of the logs, ready to paste into a bug report" /><Button x:Name="sendDiagnosticsButton" Content="Send diagnostics…" Margin="8,0,0,0" ToolTip="Shows the report with your server, PC and folder names taken out, then opens a new GitHub Discussion for it" /><TextBlock x:Name="copyDiagnosticsDone" Style="{StaticResource Quiet}" VerticalAlignment="Center" Margin="10,0,0,0" /></StackPanel>
              <Border x:Name="sendDiagnosticsPanel" Style="{StaticResource Callout}" Visibility="Collapsed">
                <StackPanel>
                  <DockPanel><TextBlock Style="{StaticResource CalloutIcon}" Text="&#xE72E;" /><TextBlock Style="{StaticResource CalloutText}" Text="Nothing is sent until you post it on GitHub. Server, PC and user names, IP and MAC addresses and folder paths are taken out. You can edit it here." /></DockPanel>
                  <TextBox x:Name="sendDiagnosticsText" Margin="0,8,0,0" Padding="4,3" FontFamily="Consolas" FontSize="11" Height="200" AcceptsReturn="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                  <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button x:Name="sendDiagnosticsGoButton" Content="Copy and open GitHub Discussions" FontWeight="SemiBold" /><Button x:Name="sendDiagnosticsCancelButton" Content="Cancel" /></StackPanel>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Callout}"><DockPanel><TextBlock Style="{StaticResource CalloutIcon}" Text="&#xE72E;" /><TextBlock Style="{StaticResource CalloutText}">The developer takes privacy seriously. Apart from update checks and the Artist, Album and Lyrics lookups (which you can turn off in <Hyperlink x:Name="privacyViewsLink">Now playing views</Hyperlink>), WinSqueeze sends nothing outside your network.</TextBlock></DockPanel></Border>
              <Expander Header="What leaves your network" Style="{StaticResource More}">
                <Grid Margin="0,6,0,0" TextBlock.Foreground="#2B3A4E">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Grid.Column="0" FontWeight="SemiBold" Text="What" /><TextBlock Grid.Row="0" Grid.Column="1" FontWeight="SemiBold" Text="Goes to" /><TextBlock Grid.Row="0" Grid.Column="2" FontWeight="SemiBold" Text="Sends" />
                  <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,6,0,0" Text="Update checks" /><TextBlock Grid.Row="1" Grid.Column="1" Margin="0,6,8,0" TextWrapping="Wrap" Text="GitHub" /><TextBlock Grid.Row="1" Grid.Column="2" Margin="0,6,0,0" TextWrapping="Wrap" Text="A request for the release list. No ID, no usage data" />
                  <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,6,0,0" Text="Artist, Album, Lyrics" /><TextBlock Grid.Row="2" Grid.Column="1" Margin="0,6,8,0" TextWrapping="Wrap" Text="MusicBrainz, Wikipedia, Wikidata, Cover Art Archive, LRCLIB; Last.fm only with your key" /><TextBlock Grid.Row="2" Grid.Column="2" Margin="0,6,0,0" TextWrapping="Wrap" Text="Artist, album and track names" />
                  <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,6,0,0" Text="Send diagnostics" /><TextBlock Grid.Row="3" Grid.Column="1" Margin="0,6,8,0" TextWrapping="Wrap" Text="GitHub Discussions, when you post it" /><TextBlock Grid.Row="3" Grid.Column="2" Margin="0,6,0,0" TextWrapping="Wrap" Text="The report you checked first" />
                </Grid>
              </Expander>
              <Expander Header="About the developer" Style="{StaticResource More}">
                <StackPanel Margin="0,6,0,0" TextBlock.Foreground="#2B3A4E">
                  <TextBlock TextWrapping="Wrap" LineHeight="19" Text="Hello, I’m Mat, from London. I’m a music grad, pianist, and as someone who has owned and used Squeezebox devices since 2005 you can imagine, a bit of a serious music fan." />
                  <TextBlock TextWrapping="Wrap" LineHeight="19" Margin="0,8,0,0" Text="I wrote this app primarily for me, but I hope you like it too." />
                  <TextBlock TextWrapping="Wrap" LineHeight="19" Margin="0,8,0,0" Text="Computer Science was my first degree and I’ve been coding since 1988. But you may have guessed AI tools were involved somewhat in the production of WinSqueeze’s code. Please don’t let that put you off. I’m a critical and careful user of AI, and value human decisions far more than computer-made ones. And so my approach is this: human-led design and human-checked code." />
                  <TextBlock TextWrapping="Wrap" LineHeight="19" Margin="0,8,0,0">If something is wrong, or could be improved, please let me know in <Hyperlink x:Name="discussionsLink" NavigateUri="https://github.com/hazymat/winsqueeze/discussions">GitHub Discussions</Hyperlink>.</TextBlock>
                </StackPanel>
              </Expander>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Updates" Style="{StaticResource CardTitle}" />
              <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="Channel" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="channelCombo" Width="200" Margin="0,0,12,0">
                  <ComboBoxItem Content="Stable releases" Tag="stable" />
                  <ComboBoxItem Content="Dev builds (every change)" Tag="dev" />
                </ComboBox>
                <CheckBox x:Name="autoUpdateBox" Content="Download updates automatically" VerticalAlignment="Center" Margin="0" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="checkNowButton" Content="Check now" />
                <Button x:Name="restartToUpdateButton" Content="Restart to update" Visibility="Collapsed" FontWeight="SemiBold" />
              </StackPanel>
              <TextBlock x:Name="updateStatusText" Style="{StaticResource Quiet}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Versions" Style="{StaticResource CardTitle}" />
              <DockPanel Margin="0,4,0,0">
                <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0">
                  <Button x:Name="refreshVersionsButton" Content="Refresh" Margin="0,0,0,6" />
                  <Button x:Name="switchVersionButton" Content="Switch to this" IsEnabled="False" />
                </StackPanel>
                <ListBox x:Name="versionsList" Height="130">
                  <ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Label}" /><TextBlock Text="  ✔ running now" Foreground="#2E9E44" FontWeight="SemiBold" Visibility="{Binding CurrentVisibility}" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>
              <TextBlock x:Name="versionNotesText" Style="{StaticResource Quiet}" />
              <TextBlock Margin="0,4,0,0"><Hyperlink x:Name="versionDiscussionLink">Comments for this version</Hyperlink></TextBlock>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Callout}" Margin="0"><DockPanel><TextBlock Style="{StaticResource CalloutIcon}" /><StackPanel><TextBlock Style="{StaticResource CalloutText}" Text="WinSqueeze is free software under the GNU GPL v3. It bundles Squeezelite 2.0.0-1610 (Adrian Smith, Ralph Irving), GPL v3; its licence is in the squeezelite folder next to WinSqueeze.exe." /><TextBlock Margin="0,4,0,0"><Hyperlink x:Name="squeezeliteSourceLink" NavigateUri="https://github.com/ralph-irving/squeezelite">Squeezelite source code</Hyperlink></TextBlock></StackPanel></DockPanel></Border>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
  </TabControl>
</Window>
